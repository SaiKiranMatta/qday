# PROTOTYPE: don't flash this bootloader unless you explicitly want to lock the board. On an open
# chip it burns fuses by itself on first boot, and that can't be undone. See docs/lockdown.md.

CONFIG_IDF_TARGET="esp32s3"

# Checks the app's signature. The stock bootloader doesn't, so a locked chip must use this one.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
# Signed by `qday lockdown-prepare`, with a key that stays out of the build.
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set

CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y

# Must match firmware/partitions.csv and the board.
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Keeps the bootloader under the 32 KB before the partition table.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
