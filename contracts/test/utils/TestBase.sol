pragma solidity 0.8.28;

/// @notice The Foundry cheatcodes these tests use.
interface Vm {
    function etch(address target, bytes calldata code) external;
    function prank(address sender) external;
    function deal(address account, uint256 balance) external;
    function chainId(uint256 newChainId) external;
    function expectRevert(bytes4 selector) external;
    function expectRevert(bytes calldata message) external;
    function expectEmit() external;
    function readFile(string calldata path) external view returns (string memory);
    function parseJsonBytes(string calldata json, string calldata key) external pure returns (bytes memory);
    function parseJsonBytes32(string calldata json, string calldata key) external pure returns (bytes32);
    function parseJsonBytesArray(string calldata json, string calldata key) external pure returns (bytes[] memory);
}

/// @notice Cheatcode access, assertions, and the fixtures generated by the Rust signer.
abstract contract TestBase {
    Vm internal constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));

    string private fixtures;

    function _loadFixtures() internal {
        fixtures = vm.readFile("test/fixtures/signatures.json");
    }

    function _loadFixtures(string memory path) internal {
        fixtures = vm.readFile(path);
    }

    function _bytes(string memory key) internal view returns (bytes memory) {
        return vm.parseJsonBytes(fixtures, string.concat(".", key));
    }

    function _word(string memory key) internal view returns (bytes32) {
        return vm.parseJsonBytes32(fixtures, string.concat(".", key));
    }

    function _list(string memory key) internal view returns (bytes[] memory) {
        return vm.parseJsonBytesArray(fixtures, string.concat(".", key));
    }

    function _assertTrue(bool value, string memory why) internal pure {
        require(value, why);
    }

    function _assertFalse(bool value, string memory why) internal pure {
        require(!value, why);
    }

    function _assertEq(uint256 got, uint256 want, string memory why) internal pure {
        require(got == want, why);
    }

    function _assertEq(bytes32 got, bytes32 want, string memory why) internal pure {
        require(got == want, why);
    }
}
